{
    "editor.tokenColorCustomizations":
        {
            "textMateRules": [
                {
                    "name": "Asar comments",
                    "scope": ["comment.asar.line"],
                    "settings": {
                        "foreground": "#5d637e"
                        }
                },
                {
                    "name": "Asar block comments",
                    "scope": ["comment.asar.block"],
                    "settings": {
                        "foreground": "#5d7e63"
                        }
                },

                {
                    "name": "Asar strings",
                    "scope": ["string.asar"],
                    "settings": {
                        "foreground": "#A3BE8C"
                        }
                },
    
    
                {
                    "name": "65c816 Mnemonics",
                    "scope": ["keyword.asar.mnemonics"],
                    "settings": {
                        "foreground": "#81A1C1"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Indexes",
                    "scope": ["keyword.asar.mnemonics.indexes"],
                    "settings": {
                        "foreground": "#C1C181"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Length",
                    "scope": ["keyword.asar.mnemonics.length"],
                    "settings": {
                        "foreground": "#66809b"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Jumps and Returns",
                    "scope": ["keyword.asar.mnemonics.jump",
			"keyword.asar.mnemonics.return"],
                    "settings": {
                        "foreground": "#c8a060"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Status",
                    "scope": ["keyword.asar.mnemonics.status.repsep",
			"keyword.asar.mnemonics.status.carry",
			"keyword.asar.mnemonics.status.interrupt",
			"keyword.asar.mnemonics.status.overflow",
			"keyword.asar.mnemonics.status.decimal"],
                    "settings": {
                        "foreground": "#c57d83"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Breakpoints and Wait",
                    "scope": ["keyword.asar.mnemonics.breakpoint",
			"keyword.asar.mnemonics.wait"],
                    "settings": {
                        "foreground": "#e76767"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Stack operations",
                    "scope": ["keyword.asar.mnemonics.stack"],
                    "settings": {
                        "foreground": "#beb977"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Bitwise operations",
                    "scope": ["keyword.asar.mnemonics.bitwise"],
                    "settings": {
                        "foreground": "#b1a1c1"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Transfer operations",
                    "scope": ["keyword.asar.mnemonics.transfer",
			"keyword.asar.mnemonics.swap"],
                    "settings": {
                        "foreground": "#77b999"
                        }
                },
                {
                    "name": "65c816 Mnemonics - Branches",
                    "scope": ["keyword.asar.mnemonics.branch"],
                    "settings": {
                        "foreground": "#a579be"
                        }
                },
                {
                    "name": "65c816 Mnemonics - No operation",
                    "scope": ["keyword.asar.mnemonics.nop"],
                    "settings": {
                        "foreground": "#888888"
                        }
                },
    
    
    
                {
                    "name": "Asar address",
